POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres


# Django secret key. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY="changeme"

# Generate one the same way as above.
JWT_SIGNING_KEY="changeme"

# From-address used for verification, password-reset, and notification
# emails.
DEFAULT_FROM_EMAIL="noreply@example.com"

# Dev SMTP target — Mailpit (docker-compose service), view caught mail at
# http://localhost:8025. Leave unset to use the defaults below.
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025

# Task queue (RQ) — points at the docker-compose `redis` service by default.
REDIS_URL="redis://redis:6379/0"
